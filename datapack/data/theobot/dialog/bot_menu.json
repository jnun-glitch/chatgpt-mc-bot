{
  "type": "minecraft:multi_action",
  "title": "TheoBot • Bots",
  "external_title": "TheoBot • Bots",
  "body": {
    "type": "minecraft:plain_message",
    "contents": "Bot-Verwaltung\nErzeugt einzelne Bots, fünf Starter-Bots oder einen separaten Trainings-Bot.",
    "width": 360
  },
  "pause": false,
  "after_action": "none",
  "columns": 2,
  "actions": [
    {
      "label": "▶ Einen Bot spawnen",
      "tooltip": "Initialisiert einen einzelnen TheoBot-Slot.",
      "width": 180,
      "action": {
        "type": "run_command",
        "command": "function theobot:bot/spawn"
      }
    },
    {
      "label": "▶ 5 Bots spawnen",
      "tooltip": "Initialisiert fünf getrennte TheoBot-Slots.",
      "width": 180,
      "action": {
        "type": "run_command",
        "command": "function theobot:bot/spawn_all"
      }
    },
    {
      "label": "🧪 Training-Bot",
      "tooltip": "Startet TheoTrainer im dedizierten TRAINING-Modus.",
      "width": 180,
      "action": {
        "type": "run_command",
        "command": "function theobot:bot/spawn_training"
      }
    },
    {
      "label": "🧪 5 Training-Bots",
      "tooltip": "Startet fünf Starter-Bots direkt im TRAINING-Modus.",
      "width": 180,
      "action": {
        "type": "run_command",
        "command": "function theobot:bot/spawn_training_all"
      }
    },
    {
      "label": "♻ Reset",
      "tooltip": "Stoppt und trennt alle verwalteten Bots.",
      "width": 180,
      "action": {
        "type": "show_dialog",
        "dialog": "theobot:confirm_reset"
      }
    },
    {
      "label": "🗑 Alle entfernen",
      "tooltip": "Entfernt alle verwalteten TheoBot-Bots.",
      "width": 180,
      "action": {
        "type": "show_dialog",
        "dialog": "theobot:confirm_remove"
      }
    }
  ],
  "exit_action": {
    "label": "← Zurück",
    "width": 180,
    "action": {
      "type": "show_dialog",
      "dialog": "theobot:main"
    }
  }
}
