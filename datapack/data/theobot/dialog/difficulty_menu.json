{
  "type": "minecraft:multi_action",
  "title": "TheoBot • Schwierigkeit",
  "external_title": "TheoBot • Schwierigkeit",
  "body": {
    "type": "minecraft:plain_message",
    "contents": "Schwierigkeits-Presets.\nSie beeinflussen Entscheidungstaktung und den von HeroBot simulierten Ping.",
    "width": 360
  },
  "pause": false,
  "after_action": "none",
  "columns": 2,
  "actions": [
    {
      "label": "EASY",
      "tooltip": "Ruhigeres Verhalten, 100 ms simulierter Ping.",
      "width": 180,
      "action": {
        "type": "run_command",
        "command": "function theobot:config/difficulty/easy"
      }
    },
    {
      "label": "NORMAL",
      "tooltip": "Standardprofil, 50 ms simulierter Ping.",
      "width": 180,
      "action": {
        "type": "run_command",
        "command": "function theobot:config/difficulty/normal"
      }
    },
    {
      "label": "HARD",
      "tooltip": "Schnelleres Verhalten, 25 ms simulierter Ping.",
      "width": 180,
      "action": {
        "type": "run_command",
        "command": "function theobot:config/difficulty/hard"
      }
    },
    {
      "label": "CUSTOM",
      "tooltip": "Projekt-Konfiguration unverändert über das Custom-Preset verwenden.",
      "width": 180,
      "action": {
        "type": "run_command",
        "command": "function theobot:config/difficulty/custom"
      }
    }
  ],
  "exit_action": {
    "label": "← Zurück",
    "width": 180,
    "action": {
      "type": "show_dialog",
      "dialog": "theobot:main"
    }
  }
}
